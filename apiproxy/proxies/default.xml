<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">

    <Description>Default Proxy Endpoint – request/response AssignMessage</Description>

    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>AM-SetRequestHeaders</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>

    <Flows>

        <Flow name="Allow-GET">
            <Condition>(request.verb = "GET")</Condition>
        </Flow>

        <Flow name="Reject-NonGET">
            <Condition>(request.verb != "GET")</Condition>
            <Request>
                <Step>
                    <Name>RF-MethodNotAllowed</Name>
                </Step>
            </Request>
        </Flow>

    </Flows>

    <PostFlow name="PostFlow">
        <Request/>
        <Response>
            <Step>
                <Name>AM-SetResponsePayload</Name>
            </Step>
        </Response>
    </PostFlow>

    <HTTPProxyConnection>
        <BasePath>/proxy-demo-2</BasePath>
        <VirtualHost>secure</VirtualHost>
    </HTTPProxyConnection>

    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>

</ProxyEndpoint>
